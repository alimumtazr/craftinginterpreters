class Cake {
  taste() {
    var adjective = "delicious";
    print "The " + this.flavor + " cake is " + adjective + "!";
  }
}
var cake = Cake();
cake.flavor = "German chocolate";
cake.taste();   // expect: The German chocolate cake is delicious!

class Person {
  sayName() { print this.name; }
}
var jane = Person();
jane.name = "Jane";
var method = jane.sayName;
method();       // expect: Jane
